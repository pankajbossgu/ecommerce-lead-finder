# Atlas URI for the ecommerce_lead_finder database. Never commit a real URI.
MONGODB_URI=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DISCOVERY_RATE_LIMIT_WINDOW_MS=900000
DISCOVERY_RATE_LIMIT_MAX=10
DISCOVERY_MAX_ATTEMPTS=4
DISCOVERY_BATCH_SIZE=30

# Email outreach (required only for campaigns with the email channel). EMAIL_FROM
# must be a syntactically valid sender on a domain verified in your Resend account.
# Set both in local .env and Vercel Project Settings → Environment Variables.
# Never commit credentials or copy a production key into this file.
