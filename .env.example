# Atlas URI must target the ecommerce_lead_finder database. Never commit a real URI.
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DISCOVERY_RATE_LIMIT_WINDOW_MS=900000
DISCOVERY_RATE_LIMIT_MAX=10
DISCOVERY_MAX_ATTEMPTS=4
DISCOVERY_BATCH_SIZE=30
